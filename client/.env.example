# Origin of the Kupaa API, no trailing slash and no /api suffix.
# Leave unset for local dev (vite proxies /api to localhost:4000) or when the
# server itself hosts the built SPA. Required for GitHub Pages / any CDN, where
# the frontend and API live on different origins.
VITE_API_URL=https://kupaa-api.onrender.com

# Public path the SPA is served from. "/" for same-origin, "/<repo>/" for a
# GitHub Pages project site (the deploy workflow sets this automatically).
# VITE_BASE=/kupaa-health-products/
