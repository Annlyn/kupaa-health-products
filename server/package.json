{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "npm run db:provider && prisma generate",
    "db:push": "npm run db:provider && prisma db push",
    "db:setup": "npm run db:provider && prisma generate && prisma db push && node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "studio": "prisma studio",
    "seed:reset": "node prisma/seed.js --reset",
    "db:provider": "node scripts/set-db-provider.js",
    "db:export": "node scripts/export-db.js",
    "db:import": "npm run db:provider && prisma generate && node scripts/import-db.js",
    "demo:data": "node ../demo/export.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "razorpay": "^2.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
