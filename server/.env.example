# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
# Where the storefront is served from. Comma-separate several origins, e.g. a
# GitHub Pages site plus a custom domain:
#   CLIENT_URL=https://yourname.github.io,https://shop.example.com
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# SQLite out of the box. For Postgres:
# DATABASE_URL="postgresql://user:pass@localhost:5432/kupaa"
# (also switch `provider` in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------- auth
# CHANGE THESE. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=180

# ---------------------------------------------------------------- seeded admin
ADMIN_EMAIL=admin@kupaahealth.com
ADMIN_NAME=Kupaa Admin
# Leave ADMIN_PASSWORD blank and `npm run seed` generates a strong one and prints
# it once. Set it yourself to choose your own — never a value from these docs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=

# ---------------------------------------------------------------- store rules
STORE_NAME=Kupaa Health Products
STORE_EMAIL=support@kupaahealth.com
CURRENCY=INR
TAX_PERCENT=0
# Set a positive amount to enable free delivery; 0 keeps delivery paid.
FREE_SHIPPING_ABOVE=0
FLAT_SHIPPING_FEE=59
COD_ENABLED=true
COD_EXTRA_FEE=0

# ---------------------------------------------------------------- razorpay
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard > Webhooks (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------- amazon shipping
# Amazon Shipping runs on SP-API. Register a Login with Amazon (LWA) app under
# Seller Central > Apps & Services > Develop Apps, then authorise it to get the
# refresh token. Leave these blank to run shipping in mock mode.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
# SP-API regional endpoint — India is served by "eu"
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_CARRIER_ID=AMZN_IN

# Pickup address. Rate quotes and labels need the full origin, not just a PIN code.
AMAZON_SHIP_FROM_NAME=Kupaa Health Products
AMAZON_SHIP_FROM_LINE1=4th Floor, Wellness House, Anna Salai
AMAZON_SHIP_FROM_LINE2=
AMAZON_SHIP_FROM_CITY=Chennai
AMAZON_SHIP_FROM_STATE=Tamil Nadu
AMAZON_SHIP_FROM_PINCODE=600002
AMAZON_SHIP_FROM_COUNTRY=IN
AMAZON_SHIP_FROM_PHONE=9876543210
AMAZON_SHIP_FROM_EMAIL=

# Optional shared secret for POST /api/shipping/webhook (x-api-key header).
# SP-API pushes notifications to EventBridge/SQS, so point your relay here.
SHIPPING_WEBHOOK_TOKEN=

# --------------------------------------------------------- sign-in security
# Sign-in confirms the email or mobile number with a one-time code before the
# password, then remembers the browser so it only happens once.
# Codes go out over WhatsApp (phone) or SMTP (email); with neither configured
# they are only written to the server log.
LOGIN_OTP_ENABLED=true
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5
# How long a verified browser stays trusted
TRUSTED_DEVICE_DAYS=180

# SMTP, for codes sent to an email address
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -------------------------------------------------------- whatsapp messages
# WhatsApp Cloud API: Meta for Developers > your app > WhatsApp > API setup.
# Use a permanent system-user token, not the 24-hour test token.
# Leave blank to log messages instead of sending them.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Where new order and payment alerts go — your own number, any format
WHATSAPP_OWNER_NUMBER=
# Prefixed to 10-digit numbers so they reach WhatsApp in E.164
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Approved template names. Blank falls back to plain text, which Meta only
# delivers inside the 24 hours after the customer messages you.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
WHATSAPP_TEMPLATE_INVOICE=

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_MB=5
