# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# SQLite out of the box. For Postgres:
# DATABASE_URL="postgresql://user:pass@localhost:5432/kupaa"
# (also switch `provider` in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------- auth
# CHANGE THESE. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- seeded admin
ADMIN_EMAIL=admin@kupaahealth.com
ADMIN_NAME=Kupaa Admin
# Leave ADMIN_PASSWORD blank and `npm run seed` generates a strong one and prints
# it once. Set it yourself to choose your own — never a value from these docs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=

# ---------------------------------------------------------------- store rules
STORE_NAME=Kupaa Health Products
STORE_EMAIL=support@kupaahealth.com
CURRENCY=INR
TAX_PERCENT=0
FREE_SHIPPING_ABOVE=999
FLAT_SHIPPING_FEE=59
COD_ENABLED=true
COD_EXTRA_FEE=0

# ---------------------------------------------------------------- razorpay
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard > Webhooks (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- shiprocket
# Create an API user at Shiprocket > Settings > API > Configure
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Origin pincode used for serviceability / rate checks
SHIPROCKET_PICKUP_PINCODE=600001
# Optional shared secret configured in Shiprocket webhook settings (x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_MB=5
