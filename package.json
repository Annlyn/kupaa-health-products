{
  "name": "kupaa-health-products",
  "private": true,
  "version": "1.0.0",
  "description": "Kupaa Health Products - full stack e-commerce (catalog, auth, admin, Razorpay, Amazon Shipping)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && node scripts/bootstrap.mjs && npm run db:setup -w server",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "bootstrap": "node scripts/bootstrap.mjs",
    "seed:reset": "npm run seed:reset -w server",
    "demo:data": "npm run demo:data -w server",
    "demo:test": "esbuild demo/adapter.js --bundle --format=esm --platform=node --loader:.json=json --define:import.meta.env.VITE_DEMO='\"true\"' --define:import.meta.env.BASE_URL='\"/\"' --outfile=demo/.test-bundle.mjs --log-level=warning && node demo/test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "webpack": "^5.110.1"
  }
}
